  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT",
        "description": "Supabase access token. Browser aplikasi umumnya memakai cookie sesi HTTP-only."
      }
    },
    "parameters": {
      "TaskId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      },
      "ApplicationId": {
        "name": "application_id",
        "in": "path",
        "required": true,
        "schema": {
          "type": "string",
          "format": "uuid"
        }
      }
    },
    "schemas": {
      "LoginRequest": {
        "type": "object",
        "required": [
          "identifier",
          "password"
        ],
        "properties": {
          "identifier": {
            "type": "string",
            "minLength": 1
          },
          "password": {
            "type": "string",
            "minLength": 1
          }
        },
        "additionalProperties": false
      },
      "TaskMode": {
        "type": "string",
        "enum": [
          "langsung",
          "pelamar",
          "cepat"
        ]
      },
      "TaskStatus": {
        "type": "string",
        "enum": [
          "diajukan",
          "menunggu_persetujuan_koordinator",
          "dikonfirmasi",
          "dikerjakan",
          "menunggu_persetujuan_keluarga",
          "selesai",
          "dibatalkan"
        ]
      },
      "CreateTaskBase": {
        "type": "object",
        "required": [
          "lansia_id",
          "service_category_id",
          "jadwal_waktu",
          "mode_penugasan"
        ],
        "properties": {
          "lansia_id": {
            "type": "string",
            "format": "uuid"
          },
          "service_category_id": {
            "type": "string",
            "format": "uuid"
          },
          "jadwal_waktu": {
            "type": "string",
            "format": "date-time"
          },
          "catatan": {
            "type": "string",
            "maxLength": 1000
          },
          "mode_penugasan": {
            "$ref": "#/components/schemas/TaskMode"
          }
        }
      },
      "CreateTaskRequest": {
        "oneOf": [
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateTaskBase"
              },
              {
                "type": "object",
                "required": [
                  "helper_id"
                ],
                "properties": {
                  "mode_penugasan": {
                    "const": "langsung"
                  },
                  "helper_id": {
                    "type": "string",
                    "format": "uuid"
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateTaskBase"
              },
              {
                "type": "object",
                "properties": {
                  "mode_penugasan": {
                    "const": "pelamar"
                  },
                  "helper_id": {
                    "type": "null"
                  }
                }
              }
            ]
          },
          {
            "allOf": [
              {
                "$ref": "#/components/schemas/CreateTaskBase"
              },
              {
                "type": "object",
                "properties": {
                  "mode_penugasan": {
                    "const": "cepat"
                  },
                  "helper_id": {
                    "type": "null"
                  }
                }
              }
            ]
          }
        ],
        "discriminator": {
          "propertyName": "mode_penugasan"
        }
      },
      "MarketplaceTask": {
        "type": "object",
        "required": [
          "task_id",
          "mode_penugasan",
          "kategori",
          "jadwal_waktu",
          "harga_dasar",
          "lokasi_ringkas",
          "expires_at"
        ],
        "properties": {
          "task_id": {
            "type": "string",
            "format": "uuid"
          },
          "mode_penugasan": {
            "type": "string",
            "enum": [
              "pelamar",
              "cepat"
            ]
          },
          "kategori": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "format": "uuid"
              },
              "nama": {
                "type": "string"
              },
              "estimasi_durasi_menit": {
                "type": "integer",
                "minimum": 1
              }
            },
            "required": [
              "id",
              "nama",
              "estimasi_durasi_menit"
            ]
          },
          "jadwal_waktu": {
            "type": "string",
            "format": "date-time"
          },
          "harga_dasar": {
            "type": "number",
            "minimum": 0
          },
          "lokasi_ringkas": {
            "type": "object",
            "properties": {
              "kelurahan": {
                "type": "string"
              },
              "kecamatan": {
                "type": "string"
              },
              "jarak_km": {
                "type": "number",
                "minimum": 0
              }
            },
            "required": [
              "kelurahan",
              "kecamatan",
              "jarak_km"
            ]
          },
          "expires_at": {
            "type": "string",
            "format": "date-time"
          },
          "application_status": {
            "type": [
              "string",
              "null"
            ],
            "enum": [
              "pending",
              "selected",
              "withdrawn",
              "rejected",
              "expired",
              null
            ]
          }
        }
      },
      "ApiError": {
        "type": "object",
        "required": [
          "error",
          "message"
        ],
        "properties": {
          "error": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "fieldErrors": {
            "type": "object",
            "additionalProperties": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Request tidak dapat dibaca",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Sesi tidak tersedia",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Forbidden": {
        "description": "Actor tidak berwenang",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "NotFound": {
        "description": "Resource atau feature tidak tersedia",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "Conflict": {
        "description": "State berubah atau terjadi race condition",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      },
      "ValidationError": {
        "description": "Kombinasi field atau aturan domain tidak valid",
        "content": {
          "application/json": {
            "schema": {
              "$ref": "#/components/schemas/ApiError"
            }
          }
        }
      }
    }
  },
  "security": [
    {
      "bearerAuth": []
    }
  ]
}
