{
  "openapi": "3.1.0",
  "info": {
    "title": "Rangkul API",
    "version": "2026.09-sprint6",
    "description": "Kontrak API inti Rangkul dan mode penugasan Sprint 6. Business rule mengikuti docs/TDD_Rangkul.md."
  },
  "servers": [
    {
      "url": "{baseUrl}",
      "variables": {
        "baseUrl": {
          "default": "http://localhost:3000"
        }
      }
    }
  ],
  "tags": [
    {
      "name": "Auth",
      "description": "Autentikasi akun dan sesi"
    },
    {
      "name": "Users",
      "description": "Profil pengguna saat ini"
    },
    {
      "name": "Lansia",
      "description": "Profil lansia dan Riwayat Rangkul"
    },
    {
      "name": "Helper",
      "description": "Katalog, profil, dan pendaftaran Helper"
    },
    {
      "name": "Koordinator",
      "description": "Persetujuan tugas dan pengawasan wilayah"
    },
    {
      "name": "Tasks",
      "description": "Siklus hidup dan manajemen tugas"
    },
    {
      "name": "Applications",
      "description": "Lamaran tugas mode pelamar"
    },
    {
      "name": "Marketplace",
      "description": "Pencarian tugas untuk Helper"
    },
    {
      "name": "Payments",
      "description": "Escrow, tagihan, dan settlement pembayaran"
    },
    {
      "name": "Emergency",
      "description": "Tombol darurat SOS dan pelaporan"
    },
    {
      "name": "Reports",
      "description": "Laporan keluhan formal pengguna"
    }
  ],
  "paths": {
    "/api/auth/login": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Masuk memakai username atau email",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login berhasil dan cookie sesi dipasang"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Keluar dari sesi saat ini dan menghapus cookie autentikasi",
        "responses": {
          "200": {
            "description": "Logout berhasil"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/auth/register": {
      "post": {
        "tags": [
          "Auth"
        ],
        "summary": "Registrasi pengguna baru (Keluarga, Helper, Koordinator)",
        "security": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "email",
                  "password",
                  "full_name",
                  "role",
                  "phone"
                ],
                "properties": {
                  "email": {
                    "type": "string",
                    "format": "email"
                  },
                  "password": {
                    "type": "string",
                    "minLength": 8
                  },
                  "full_name": {
                    "type": "string",
                    "minLength": 2
                  },
                  "role": {
                    "type": "string",
                    "enum": [
                      "keluarga",
                      "helper",
                      "koordinator"
                    ]
                  },
                  "phone": {
                    "type": "string",
                    "minLength": 10
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Akun berhasil didaftarkan"
          },
          "400": {
            "$ref": "#/components/responses/BadRequest"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/emergency": {
      "post": {
        "tags": [
          "Emergency"
        ],
        "summary": "Memicu sinyal darurat SOS oleh Helper di lapangan (TDD §3.6)",
        "x-rangkul-roles": [
          "helper"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "task_id"
                ],
                "properties": {
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "catatan": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Alert darurat disiarkan ke Keluarga dan Koordinator wilayah"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/helper/profile": {
      "get": {
        "tags": [
          "Helper"
        ],
        "summary": "Profil pribadi Helper yang sedang login",
        "x-rangkul-roles": [
          "helper"
        ],
        "responses": {
          "200": {
            "description": "Data profil, saldo, kategori layanan, dan trust tier Helper"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "patch": {
        "tags": [
          "Helper"
        ],
        "summary": "Memperbarui bio, radius layanan, ketersediaan, atau kategori Helper",
        "x-rangkul-roles": [
          "helper"
        ],
        "responses": {
          "200": {
            "description": "Profil Helper diperbarui"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/helpers": {
      "get": {
        "tags": [
          "Helper"
        ],
        "summary": "Katalog Helper terverifikasi dengan filter radius dan kategori",
        "x-rangkul-roles": [
          "keluarga",
          "helper",
          "koordinator",
          "admin"
        ],
        "parameters": [
          {
            "name": "wilayah",
            "in": "query",
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "kategori",
            "in": "query",
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "radius",
            "in": "query",
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Daftar Helper terverifikasi yang melayani wilayah target"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          }
        }
      }
    },
    "/api/helpers/apply": {
      "post": {
        "tags": [
          "Helper"
        ],
        "summary": "Pengajuan verifikasi Helper ke Koordinator RT/RW domisili (TDD §3.3.1)",
        "x-rangkul-roles": [
          "helper"
        ],
        "responses": {
          "201": {
            "description": "Pengajuan verifikasi dikirim ke Koordinator"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/helpers/{id}": {
      "get": {
        "tags": [
          "Helper"
        ],
        "summary": "Detail profil publik Helper",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profil publik Helper termasuk rating, tugas selesai, dan tingkat kepercayaan"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/koordinator/task-approvals": {
      "get": {
        "tags": [
          "Koordinator"
        ],
        "summary": "Antrean tugas yang membutuhkan persetujuan eksplisit Koordinator (TDD §3.3.2)",
        "x-rangkul-roles": [
          "koordinator"
        ],
        "responses": {
          "200": {
            "description": "Daftar tugas menunggu persetujuan Koordinator wilayah"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      }
    },
    "/api/lansia": {
      "get": {
        "tags": [
          "Lansia"
        ],
        "summary": "Daftar profil lansia milik keluarga yang login",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "responses": {
          "200": {
            "description": "Daftar profil lansia aktif"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Lansia"
        ],
        "summary": "Menambahkan profil lansia baru beserta dokumen identitas dan hubungan keluarga",
        "description": "Sesuai TDD §3.11, dokumen disimpan di storage private tanpa verifikasi manual di muka.",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "nama",
                  "alamat",
                  "lat",
                  "lng",
                  "provinsi",
                  "kabupaten_kota",
                  "kecamatan",
                  "kelurahan",
                  "rt",
                  "rw",
                  "umur",
                  "tingkat_mobilitas",
                  "hubungan_keluarga"
                ],
                "properties": {
                  "nama": {
                    "type": "string",
                    "minLength": 2
                  },
                  "alamat": {
                    "type": "string",
                    "minLength": 5
                  },
                  "lat": {
                    "type": "number"
                  },
                  "lng": {
                    "type": "number"
                  },
                  "catatan_kondisi": {
                    "type": "string"
                  },
                  "dokumen_identitas_lansia_url": {
                    "type": "string"
                  },
                  "dokumen_hubungan_keluarga_url": {
                    "type": "string"
                  },
                  "foto_url": {
                    "type": "string"
                  },
                  "hubungan_keluarga": {
                    "type": "string"
                  },
                  "provinsi": {
                    "type": "string"
                  },
                  "kabupaten_kota": {
                    "type": "string"
                  },
                  "kecamatan": {
                    "type": "string"
                  },
                  "kelurahan": {
                    "type": "string"
                  },
                  "rt": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "rw": {
                    "type": "integer",
                    "minimum": 1
                  },
                  "umur": {
                    "type": "integer",
                    "minimum": 50
                  },
                  "tingkat_mobilitas": {
                    "type": "string"
                  },
                  "kebutuhan_khusus": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Profil lansia berhasil dibuat"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/lansia/{id}": {
      "get": {
        "tags": [
          "Lansia"
        ],
        "summary": "Detail profil lansia",
        "x-rangkul-roles": [
          "keluarga",
          "admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Detail lansia"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      },
      "patch": {
        "tags": [
          "Lansia"
        ],
        "summary": "Memperbarui profil lansia",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profil lansia diperbarui"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      },
      "delete": {
        "tags": [
          "Lansia"
        ],
        "summary": "Soft delete profil lansia (TDD §3.5)",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Profil lansia dinonaktifkan"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/lansia/{id}/riwayat": {
      "get": {
        "tags": [
          "Lansia"
        ],
        "summary": "Riwayat Rangkul: timeline kunjungan, tren Health Snapshot, dan badge perhatian (TDD §3.12)",
        "x-rangkul-roles": [
          "keluarga",
          "admin"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Timeline, tren 5 indikator, dan status peringatan dini rule-based"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/payments/{task_id}": {
      "get": {
        "tags": [
          "Payments"
        ],
        "summary": "Status pembayaran dan escrow suatu tugas",
        "x-rangkul-roles": [
          "keluarga",
          "helper",
          "admin"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Data rincian pembayaran dan status escrow"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
        }
      }
    },
    "/api/payments/{task_id}/charge": {
      "post": {
        "tags": [
          "Payments"
        ],
        "summary": "Inisiasi checkout Midtrans Snap atau Saldo Demo untuk tugas yang dikonfirmasi (TDD §3.4)",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "parameters": [
          {
            "name": "task_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Snap token atau status hold escrow berhasil dibuat"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          }
        }
      }
    },
    "/api/reports": {
      "post": {
        "tags": [
          "Reports"
        ],
        "summary": "Mengirimkan laporan keluhan formal terhadap Helper atau Keluarga (TDD §3.10)",
        "x-rangkul-roles": [
          "keluarga",
          "helper",
          "koordinator"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": [
                  "target_user_id",
                  "kategori",
                  "deskripsi"
                ],
                "properties": {
                  "target_user_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "task_id": {
                    "type": "string",
                    "format": "uuid"
                  },
                  "kategori": {
                    "type": "string"
                  },
                  "deskripsi": {
                    "type": "string",
                    "minLength": 10
                  },
                  "bukti_url": {
                    "type": "string"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Laporan tercatat; pemicu under_review bila terkumpul 2 laporan"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tasks": {
      "get": {
        "tags": [
          "Tasks"
        ],
        "summary": "Daftar task sesuai role dan relasi actor",
        "x-rangkul-roles": [
          "keluarga",
          "helper",
          "koordinator",
          "admin"
        ],
        "responses": {
          "200": {
            "description": "Daftar task yang dapat dilihat actor"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          }
        }
      },
      "post": {
        "tags": [
          "Tasks"
        ],
        "summary": "Membuat booking langsung, pelamar, atau cepat",
        "description": "Mode langsung wajib memiliki helper_id. Mode pelamar dan cepat tidak menerima helper_id. Mode Sprint 6 mengembalikan 404 saat feature flag nonaktif.",
        "x-rangkul-roles": [
          "keluarga"
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateTaskRequest"
              },
              "examples": {
                "langsung": {
                  "value": {
                    "mode_penugasan": "langsung",
                    "helper_id": "11111111-1111-4111-8111-111111111111",
                    "lansia_id": "22222222-2222-4222-8222-222222222222",
                    "service_category_id": "33333333-3333-4333-8333-333333333333",
                    "jadwal_waktu": "2026-09-06T09:00:00+07:00"
                  }
                },
                "pelamar": {
                  "value": {
                    "mode_penugasan": "pelamar",
                    "lansia_id": "22222222-2222-4222-8222-222222222222",
                    "service_category_id": "33333333-3333-4333-8333-333333333333",
                    "jadwal_waktu": "2026-09-06T13:00:00+07:00"
                  }
                },
                "cepat": {
                  "value": {
                    "mode_penugasan": "cepat",
                    "lansia_id": "22222222-2222-4222-8222-222222222222",
                    "service_category_id": "33333333-3333-4333-8333-333333333333",
                    "jadwal_waktu": "2026-09-05T16:00:00+07:00"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Task dibuat"
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          },
          "409": {
            "$ref": "#/components/responses/Conflict"
          },
          "422": {
            "$ref": "#/components/responses/ValidationError"
          }
        }
      }
    },
    "/api/tasks/marketplace": {
      "get": {
        "tags": [
          "Marketplace"
        ],
        "summary": "Marketplace tereduksi untuk Helper eligible",
        "description": "Tidak mengirim nama, foto, alamat lengkap, koordinat, atau catatan kesehatan lansia.",
        "x-rangkul-roles": [
          "helper"
        ],
        "parameters": [
          {
            "name": "mode",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "enum": [
                "pelamar",
                "cepat"
              ]
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 50,
              "default": 20
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Task yang lolos eligibility server",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/MarketplaceTask"
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "401": {
            "$ref": "#/components/responses/Unauthorized"
          },
          "403": {
            "$ref": "#/components/responses/Forbidden"
          },
          "404": {
            "$ref": "#/components/responses/NotFound"
          }
